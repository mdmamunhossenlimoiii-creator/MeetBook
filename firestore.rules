rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationMember(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
      return signedIn()
        && conversation.data.members is list
        && request.auth.uid in conversation.data.members;
    }

    // Users collection
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'photoURL', 'updatedAt'
        ])
        && (!('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 80))
        && (!('bio' in request.resource.data)
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 500))
        && (!('photoURL' in request.resource.data)
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048));
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Posts collection. Counts must always match their backing arrays.
    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhotoURL', 'content', 'imageUrl',
          'createdAt', 'updatedAt', 'likes', 'likesCount', 'comments', 'commentsCount'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 5000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0
        && request.resource.data.likesCount == 0
        && request.resource.data.comments is list
        && request.resource.data.comments.size() == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'likesCount', 'comments', 'commentsCount', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.likes == resource.data.likes
            && request.resource.data.likesCount == resource.data.likesCount
          )
          ||
          (
            request.resource.data.likes is list
            && request.resource.data.likesCount == request.resource.data.likes.size()
            && request.resource.data.likes.size() <= resource.data.likes.size() + 1
            && request.resource.data.likes.size() >= resource.data.likes.size() - 1
            && (
              (
                request.resource.data.likes.size() == resource.data.likes.size() + 1
                && request.resource.data.likes.hasAll(resource.data.likes)
                && request.auth.uid in request.resource.data.likes
                && !(request.auth.uid in resource.data.likes)
              )
              ||
              (
                request.resource.data.likes.size() == resource.data.likes.size() - 1
                && resource.data.likes.hasAll(request.resource.data.likes)
                && request.auth.uid in resource.data.likes
                && !(request.auth.uid in request.resource.data.likes)
              )
            )
          )
        )
        && (
          request.resource.data.comments == resource.data.comments
          && request.resource.data.commentsCount == resource.data.commentsCount
          ||
          (
            request.resource.data.comments is list
            && request.resource.data.comments.size() == resource.data.comments.size() + 1
            && request.resource.data.commentsCount == request.resource.data.comments.size()
            && request.resource.data.comments.hasAll(resource.data.comments)
            && request.resource.data.comments[request.resource.data.comments.size() - 1].authorId == request.auth.uid
            && request.resource.data.comments[request.resource.data.comments.size() - 1].content is string
            && request.resource.data.comments[request.resource.data.comments.size() - 1].content.size() >= 1
            && request.resource.data.comments[request.resource.data.comments.size() - 1].content.size() <= 1000
          )
          ||
          (
            request.auth.uid == resource.data.authorId
            && request.resource.data.comments is list
            && resource.data.comments.hasAll(request.resource.data.comments)
            && request.resource.data.comments.size() == resource.data.comments.size() - 1
            && request.resource.data.commentsCount == request.resource.data.comments.size()
          )
        );

      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    // Conversations are readable only by their listed participants.
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'type', 'groupName', 'members', 'memberNames', 'memberPhotos',
          'createdBy', 'createdAt', 'updatedAt', 'lastMessage',
          'lastMessageAt', 'unreadCounts'
        ])
        && request.resource.data.type in ['direct', 'group']
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.resource.data.members.hasAll([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberNames is map
        && request.resource.data.memberPhotos is map
        && request.resource.data.unreadCounts is map
        && request.resource.data.memberNames.keys().hasAll(request.resource.data.members)
        && request.resource.data.memberPhotos.keys().hasAll(request.resource.data.members)
        && request.resource.data.unreadCounts.keys().hasAll(request.resource.data.members)
        && request.resource.data.memberNames.keys().hasOnly(request.resource.data.members)
        && request.resource.data.memberPhotos.keys().hasOnly(request.resource.data.members)
        && request.resource.data.unreadCounts.keys().hasOnly(request.resource.data.members)
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 5000
        && (
          (request.resource.data.type == 'direct'
            && request.resource.data.members.size() == 2)
          ||
          (request.resource.data.type == 'group'
            && request.resource.data.groupName is string
            && request.resource.data.groupName.size() >= 2
            && request.resource.data.groupName.size() <= 60)
        );

      // Participants may update the conversation preview and unread counters,
      // but cannot change its membership, type, or creator.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'updatedAt', 'unreadCounts'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 5000
        && request.resource.data.unreadCounts is map
        && request.resource.data.unreadCounts.keys().hasAll(resource.data.members)
        && request.resource.data.unreadCounts.keys().hasOnly(resource.data.members)
        && request.resource.data.unreadCounts.diff(resource.data.unreadCounts)
          .affectedKeys().hasOnly([request.auth.uid]);

      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);

        // Phase 1 initially supports authenticated text messages.
        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'type', 'text', 'createdAt', 'readBy'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy is list
          && request.resource.data.readBy.size() == 1
          && request.resource.data.readBy.hasOnly([request.auth.uid]);

        // A participant may add only their own read receipt.
        allow update: if isConversationMember(conversationId)
          && request.auth.uid != resource.data.senderId
          && !(request.auth.uid in resource.data.readBy)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
          && request.resource.data.readBy.hasOnly(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          )
          && request.auth.uid in request.resource.data.readBy;

        allow delete: if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
